# Frontend 환경 변수 예시 — 실제 값은 .env.local 로 분리하고 git 커밋 금지
# EXPO_PUBLIC_ 접두사만 클라이언트 번들에 포함됨

EXPO_PUBLIC_API_BASE=http://10.0.2.2:8080

# 카카오 네이티브 앱 키 — 모바일 네이티브 SDK 로그인용 (카카오 콘솔 > 앱 키 > 네이티브 앱 키)
# app.config.js 의 @react-native-seoul/kakao-login 플러그인 kakaoAppKey 로 주입됨.
# 빈 값이면 네이티브 빌드 시 kakao{KEY}:// 스킴이 비어 모바일 로그인이 동작하지 않음.
# EAS 클라우드 빌드에서는 EAS 프로젝트 환경변수에도 동일 값 등록 필요.
EXPO_PUBLIC_KAKAO_NATIVE_KEY=

# 카카오 REST API 키 — 웹 OAuth 인가 URL 의 client_id (네이티브 키와 다름)
EXPO_PUBLIC_KAKAO_REST_KEY=

# 카카오 redirect_uri — 웹 OAuth 콜백. 카카오 콘솔 + 백엔드 redirect-uri 와 정확히 일치해야 함
EXPO_PUBLIC_KAKAO_REDIRECT_URI=http://localhost:3000/oauth/kakao

# 포트원(아임포트) 가맹점 식별 코드
EXPO_PUBLIC_PORTONE_IMP_CODE=